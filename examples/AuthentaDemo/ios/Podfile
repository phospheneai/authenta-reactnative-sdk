# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Enable TurboModules/Fabric (New Architecture) for libraries like react-native-nitro-modules.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AuthentaDemo' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Fix fmt consteval incompatibility with Xcode 26 / Apple Clang.
    # fmt's base.h redefines FMT_USE_CONSTEVAL internally via a plain #if/#elif chain
    # (no #ifndef guard), so -DFMT_USE_CONSTEVAL=0 on the command line gets overridden.
    # Instead, patch the header to treat ALL Apple Clang builds like pre-14 (no consteval).
    base_h_path = installer.pods_project.path.dirname.to_s + '/fmt/include/fmt/base.h'
    if File.exist?(base_h_path)
      File.chmod(0644, base_h_path)
      content = File.read(base_h_path)
      old_str = "#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L\n#  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14."
      new_str = "#elif defined(__apple_build_version__)\n#  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang."
      if content.include?(old_str)
        File.write(base_h_path, content.sub(old_str, new_str))
        Pod::UI.puts "Patched fmt/include/fmt/base.h: disabled consteval for all Apple Clang (Xcode 26 fix)"
      else
        Pod::UI.puts "fmt/include/fmt/base.h: patch already applied or not needed"
      end
    end
  end
end
